# Consistent cross-platform line endings
* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
*.glb binary
*.wasm binary

# Keep GitHub Languages bar focused on active application & research code
documentation/** linguist-documentation
research/**/*.md linguist-documentation
research/**/*.txt linguist-documentation
research/**/*.csv linguist-vendored
research/**/*.json linguist-vendored
server/data/*.json linguist-vendored
server/tests/*.csv linguist-vendored
server/tests/*.json linguist-vendored
package-lock.json linguist-generated
frontend/package-lock.json linguist-generated
