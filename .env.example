# AgriSense Fusion - Environment Configuration
# NASA Space Apps Challenge 2026: Field Shift

# Application Environment
NODE_ENV=development
PORT=5000

# Demonstration Default Location (Northern Bangladesh - Barind Tract)
DEFAULT_FARM_ID=farm-barind-01
DEFAULT_LATITUDE=24.469
DEFAULT_LONGITUDE=88.330
DEFAULT_ELEVATION_M=28.0
DEFAULT_TIMEZONE=Asia/Dhaka

# NASA POWER API Settings
# Public endpoint - no API key required for standard daily point service
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
NASA_REQUEST_TIMEOUT_MS=10000
NASA_CACHE_TTL_MS=3600000

# Edge Device Security (ESP32 Ingestion)
# In production, replace with hardware pre-shared device secrets
ESP32_DEVICE_TOKEN_SECRET=demo-device-secret-replace-in-production

# Production Database (Optional)
# If PostgreSQL is configured, provide connection string below:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agrisense_fusion
