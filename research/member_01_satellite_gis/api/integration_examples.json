    {
      "name": "Field Vegetation & Aquifer Stress Analysis",
      "method": "POST",
      "path": "/vegetation/analyze",
      "curl_example": "curl -X POST 'http://localhost:8000/vegetation/analyze' -H 'Content-Type: application/json' -d '{\"lat\": 24.469, \"lon\": 88.330, \"target_date\": \"2024-02-28\", \"crop_interest\": \"Wheat\"}'",
      "expected_response": {
        "location": { "latitude": 24.469, "longitude": 88.33 },
        "nearest_observation_date": "2024-02-28",
        "season": "Rabi_Winter",
        "ndvi_canopy_vigor": 0.2756,
        "evi_biomass_density": 0.2867,
        "ndmi_moisture_level": 0.1141,
        "ndwi_surface_water": -0.2591,
