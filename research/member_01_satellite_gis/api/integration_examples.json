          { "id": "land_cover_distribution", "title": "10m Land Cover Distribution & Area Statistics", "category": "Land Cover Analysis", "format": "PNG", "url_path": "/static/exports/visualizations/land_cover_distribution.png" },
          { "id": "study_area_geojson", "title": "Godagari Upazila Authoritative Boundary Vector", "category": "Vector GIS", "format": "GeoJSON", "url_path": "/static/exports/geojson/study_area.geojson" }
        ]
