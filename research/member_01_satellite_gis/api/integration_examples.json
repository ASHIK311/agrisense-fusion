          { "date": "2024-02-28", "season": "Rabi_Winter", "NDVI_mean": 0.2756, "EVI_mean": 0.2867, "NDWI_McFeeters_mean": -0.2591, "NDMI_Gao_mean": 0.1141 },
          { "date": "2024-04-13", "season": "Pre_Kharif_Aus", "NDVI_mean": 0.3446, "EVI_mean": 0.3971, "NDWI_McFeeters_mean": -0.3345, "NDMI_Gao_mean": 0.0786 }
